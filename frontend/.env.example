# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Your production domain (no trailing slash).
# Used to build absolute OG image and canonical URLs.
VITE_SITE_URL=https://your-domain.com

# Search Console Verification Placeholders
VITE_GOOGLE_SITE_VERIFICATION=your-google-verification-code
VITE_BING_SITE_VERIFICATION=your-bing-verification-code
